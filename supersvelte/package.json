{
  "name": "@workspace/icon-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "api:dev": "cargo run --manifest-path server/Cargo.toml",
    "api:build": "cargo build --release --manifest-path server/Cargo.toml",
    "api:start": "./server/target/release/icon-library-server",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/luxon": "^3.7.6",
    "@types/node": "catalog:",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "catalog:"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "katex": "^0.16.47",
    "luxon": "^3.7.2",
    "property-information": "^7.2.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
