modules = ["nodejs-24", "rust-stable", "python-base-3.13"]

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "supersvelte web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "supersvelte API"

[[workflows.workflow]]
name = "supersvelte API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/icon-library run api:dev"

[[workflows.workflow]]
name = "supersvelte web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/icon-library run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
